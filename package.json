{
  "name": "@ska-telescope/ska-gui-components",
  "version": "2.9.0",
  "description": "A Library of SKA GUI components using Material-UI",
  "license": "BSD-3-Clause",
  "author": "Trevor A Swain",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/ska-gui-components.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ska-gui-components.es.js"
    },
    "./controlled": {
      "types": "./dist/controlled.d.ts",
      "import": "./dist/controlled.es.js"
    },
    "./dist/assets/index.css": "./dist/assets/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "browserList": "npx browserslist@latest --update-db",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "code-analysis": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 -f junit -o linting.xml",
    "checker": "yarn build && yarn prettier:fix && yarn lint:fix",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "trevor": "eslint --print-config .storybook/main.ts",
    "merge-reports": "jrm build/reports/unit-tests.xml \"build/tests/*.xml\"",
    "prettier:fix": "prettier src/**/*.{ts,tsx} --write",
    "preview": "vite preview",
    "skao:update": "yarn add @ska-telescope/ska-javascript-components@latest",
    "storybook": "storybook dev -p 6006",
    "storybook:update": "npx storybook@latest upgrade",
    "test:coverage:report": "npx nyc report --report-dir=build/reports --reporter=html",
    "test:coverage:report:ci": "npx nyc report --report-dir=build/reports",
    "test:unit": "vitest --typecheck --coverage.enabled=true  --reporter=default",
    "test:unit:ui": "vitest --typecheck  --coverage.enabled=true  --reporter=default --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mui/material": "7.3.0",
    "@mui/system": "7.3.0",
    "@mui/x-data-grid": "^7.28.0",
    "@ska-telescope/ska-javascript-components": "^2.3.21",
    "react-dropzone": "^14.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@eslint/js": "^9.39.0",
    "@storybook/addon-essentials": "8.6.17",
    "@storybook/addon-interactions": "8.6.17",
    "@storybook/addon-links": "8.6.17",
    "@storybook/addon-onboarding": "8.6.17",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.0",
    "eslint-formatter-junit": "^9.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react-hooks": "^7",
    "jsdom": "^30.1.1",
    "junit-report-merger": "^7.0.1",
    "prettier": "^3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.0.0",
    "storybook": "^8.6.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.2.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19",
    "react-dom": "^18 || ^19",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "resolutions": {
    "js-yaml": "^3.15.2",
    "minimatch": "^10.2.6",
    "brace-expansion": "^5.0.12",
    "micromatch/picomatch": "^2.3.2",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.28",
    "nanoid": "^3.3.19",
    "ws": "^8.21.3",
    "svgo": "^3.3.5",
    "flatted": "^3.4.4",
    "uuid": "^11.1.1",
    "baseline-browser-mapping": "^2.11.26",
    "yaml": "^1.10.3",
    "@humanfs/node": "^0.16.8",
    "fflate": "^0.8.3",
    "@babel/core": "^7.29.6",
    "vitest/vite": "^7.3.5",
    "vite-node/vite": "^7.3.5",
    "@ska-telescope/ska-javascript-components/vite": "^7.3.5",
    "glob": "^13.0.6"
  },
  "packageManager": "yarn@4.12.0"
}
